# Environment Configuration for Autonomous Agentic Citizen Welfare & Policy Intelligence Platform
APP_NAME=welfare-navigator-platform
ENV=development
DEBUG=true
PORT=8000
FRONTEND_PORT=5173
MOCK_PORTAL_PORT=8001

# Database Configuration (PostgreSQL in Docker / SQLite zero-config fallback)
DATABASE_URL=sqlite+aiosqlite:///./welfare.db
SYNC_DATABASE_URL=sqlite:///./welfare.db
# Production PostgreSQL example:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/welfare_db
# SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/welfare_db

# Redis & Celery (FastAPI BackgroundTasks fallback enabled automatically if Redis is absent)
REDIS_URL=redis://localhost:6379/0
USE_CELERY=false

# Security & DPDP Act 2023 Cryptographic Salt
SECRET_SALT=welfare_platform_salt_secure_2026_dpdp_compliant
ENCRYPTION_KEY=s3cr3t_3ncrypt10n_k3y_w3lf4r3_2026_k10sk_s4f3

# External AI Integrations (Dual-Mode: Live + Local Emulation)
USE_LOCAL_AI_FALLBACK=true

# Google Gemini (for Structured AST Extraction & Vision OCR in Live Mode)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Bhashini ULCA (Vernacular Voice STT/TTS in Live Mode)
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Twilio (WhatsApp & SMS Outbox in Live Mode)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Current Reference Date for Eligibility & Document Expiry Verification
REFERENCE_DATE=2026-10-22
